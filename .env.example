PROJECT_NAME=ojs35_sumarc_test
OJS_IMAGE=sedici/ojs
OJS_VERSION=3.5.0-6

# URL publica, sin barra final. Define base_url y allowed_hosts en el primer arranque.
OJS_BASE_URL=http://localhost:8090

# Con proxy inverso en el servidor: OJS_BEHIND_PROXY=true y OJS_BIND_ADDRESS=127.0.0.1.
# Sin proxy: OJS_BEHIND_PROXY=false y OJS_BIND_ADDRESS=0.0.0.0.
OJS_BEHIND_PROXY=true
OJS_BIND_ADDRESS=127.0.0.1
OJS_PUBLIC_PORT=8090
PHPMYADMIN_PUBLIC_PORT=8091

# Cambiar antes del primer arranque. Sin comillas dobles.
MYSQL_ROOT_PASSWORD=cambiar
MYSQL_DATABASE=ojs
MYSQL_USER=ojs
MYSQL_PASSWORD=cambiar

DATA_DIR=./data
